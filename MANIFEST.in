# Source distribution contents. Everything the custom build_py in setup.py
# copies into the package must be here, taken from the repository root.
include README.md LICENSE CHANGELOG.md CONTRIBUTING.md CITATION.cff
include docs/User_Manual.md docs/Instruments_Manuals_Lists.md
recursive-include pica/assets *
# README/User Manual screenshots: shown on GitHub and the docs site only, no
# program loads them, so they stay out of the sdist and wheel.
prune pica/assets/Images/screenshots
# Logos the programs never load (README, docs site and portable build read
# them from the repository). Shipped: UGC_DAE_CSR_NBG.jpeg (every GUI header)
# and PICA_LOGO_ICON.ico (kept for a future window icon).
exclude pica/assets/LOGO/PICA_LOGO.png pica/assets/LOGO/PICA_LOGO_NBG.png
exclude pica/assets/LOGO/PICA_LOGO.ico pica/assets/LOGO/PICA_LOGO_ICON.png
exclude pica/assets/LOGO/UGC_DAE_CSR.ico pica/assets/LOGO/UGC_DAE_CSR.jpeg
# Full-resolution master of the GUI logo; the shipped UGC_DAE_CSR_NBG.jpeg is
# a 280 px copy of it (a PNG despite the name, kept for the existing paths).
exclude pica/assets/LOGO/UGC_DAE_CSR_NBG_Full_Size.jpeg
recursive-include pica *.py
recursive-include tests *.py
prune tests/__pycache__

# The copies that build_py makes inside pica/ are build products, never
# sources: keep stale local copies out of the sdist.
exclude pica/README.md pica/LICENSE pica/CHANGELOG.md pica/CONTRIBUTING.md
prune pica/docs
