# ============================================================================
# STRICT RULE: data_file_for_ref/ folders are LAB REFERENCE DATA and must
# NEVER be committed - for ANY instrument (novocontrol, keysight, PPMS,
# keithley, ...). Do NOT add exceptions, and never "fix" a CI failure by
# committing these files. Tests that compare against them (e.g.
# tests/test_fscan_against_references.py) skip cleanly when they are absent.
# ============================================================================
**/data_file_for_ref/
pica/keysight/data_file_for_ref/
pica/novocontrol/data_file_for_ref/
pica/PPMS/data_file_for_ref/

# UI prototypes (quick HTML mockups, not shipped code)
prototypes/

# ============================================================================
# Measurement data, documents and binaries: ignored everywhere by default so
# lab data, manuals and generated pages never get committed by accident.
# Deliberate exceptions are re-included at the end of this block.
# ============================================================================
data/
docs/_build/
*.dat
*.csv
*.tsv
*.txt
*.xls
*.xlsx
*.npy
*.npz
*.h5
*.hdf5
